# =============================================================================
# .env.example  (이 파일은 깃에 커밋된다 — 실제 키를 절대 적지 말 것)
# -----------------------------------------------------------------------------
# 사용법: 이 파일을 `.env` 로 복사한 뒤 본인 키로 채운다.
#   cp .env.example .env
# =============================================================================

# 앱 메타.
APP_ENV=local
APP_NAME="AI Mobile Document Assistant API"

# OpenAI API key. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# 사용할 텍스트 모델. (gpt-4o-mini / gpt-4o 등)
OPENAI_MODEL_TEXT=gpt-4o-mini

# Vision(이미지) OCR 용 모델. 4o-mini 도 vision 지원.
OPENAI_MODEL_VISION=gpt-4o-mini
